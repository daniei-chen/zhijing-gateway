+func TestBatchImageReplaySubmissionScopedOwnerAndPayload(t *testing.T) {
+	for _, owner := range []BatchImageOwner{{UserID: 12, APIKeyID: 22}, {UserID: 11, APIKeyID: 23}} {
+		svc, reader, _, req := replaySavedSubmission(t)
