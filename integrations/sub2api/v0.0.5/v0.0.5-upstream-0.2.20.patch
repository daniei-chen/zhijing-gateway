+		require.NoError(t, err)
+	}
+	for _, raw := range []string{`[3]`, `[{"api_key_id":3}]`, `[{"api_key_id":0,"user_id":1}]`, `[{"api_key_id":3,"user_id":1},{"api_key_id":3,"user_id":2}]`, strings.Repeat("x", 16385)} {
