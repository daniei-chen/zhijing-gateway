diff --git a/backend/internal/pkg/gatewaytiming/body_test.go b/backend/internal/pkg/gatewaytiming/body_test.go
new file mode 100644
index 0000000..3b67cb0
--- /dev/null
+++ b/backend/internal/pkg/gatewaytiming/body_test.go
@@ -0,0 +1,93 @@
+package gatewaytiming
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+type delayedBody struct {
+	started chan struct{}
+	ready   chan struct{}
+	closed  bool
+	read    bool
+	err     error
+}
+
+func (body *delayedBody) Read(p []byte) (int, error) {
+	if body.read {
+		return 0, io.EOF
+	}
+	body.read = true
+	close(body.started)
+	<-body.ready
+	return copy(p, "synthetic-private"), body.err
+}
+
+func (body *delayedBody) Close() error { body.closed = true; return nil }
+
+func TestBodyObservationRecordsBlockingNotPayload(t *testing.T) {
+	ctx := Start(context.Background())
+	body := &delayedBody{started: make(chan struct{}), ready: make(chan struct{})}
+	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://example.invalid", body)
+	ObserveBody(req)
+	wrapped := req.Body
+	ObserveBody(req)
+	if req.Body != wrapped {
+		t.Fatal("body wrapped twice")
+	}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, _ = io.ReadAll(req.Body)
+	}()
+	<-body.started
+	MarkIngressStage(ctx, "handler_enter")
+	MarkIngressStage(ctx, "secret-untrusted-stage")
+	time.Sleep(25 * time.Millisecond)
+	close(body.ready)
+	<-done
+	_ = req.Body.Close()
+	MarkIngressStage(ctx, "body_ready")
+	RecordBodyNormalization(ctx, time.Now())
+	MarkIngressStage(ctx, "security_complete")
+	MarkIngressStage(ctx, "routing_start")
+	snapshot := Snapshot(ctx)
+	if snapshot["body_wire_bytes"] != int64(len("synthetic-private")) || snapshot["body_read_result"] != "complete" {
+		t.Fatalf("bad body counters: %v", snapshot)
+	}
+	if snapshot["body_read_block_ms"].(int64) < 20 {
+		t.Fatal("blocking was not measured")
+	}
+	encoded, _ := json.Marshal(snapshot)
+	if strings.Contains(string(encoded), "synthetic") || strings.Contains(string(encoded), "secret-untrusted") {
+		t.Fatal("payload/stage leaked")
+	}
+	if !body.closed {
+		t.Fatal("close not delegated")
+	}
+}
+
+func TestBodyObservationPreservesErrorCancellationAndNil(t *testing.T) {
+	ObserveBody(nil)
+	req, _ := http.NewRequest(http.MethodPost, "http://example.invalid", nil)
+	ObserveBody(req)
+	ctx, cancel := context.WithCancel(Start(context.Background()))
+	cancel()
+	body := &delayedBody{started: make(chan struct{}), ready: make(chan struct{}), err: context.Canceled}
+	close(body.ready)
+	req, _ = http.NewRequestWithContext(ctx, http.MethodPost, "http://example.invalid", body)
+	ObserveBody(req)
+	_, err := io.ReadAll(req.Body)
+	if !errors.Is(err, context.Canceled) || req.Context().Err() != context.Canceled {
+		t.Fatal("cancellation changed")
+	}
+	if Snapshot(ctx)["body_read_result"] != "error" {
+		t.Fatal("failed read was counted complete")
+	}
+}
diff --git a/backend/internal/pkg/gatewaytiming/history.go b/backend/internal/pkg/gatewaytiming/history.go
new file mode 100644
index 0000000..18bf2cb
--- /dev/null
+++ b/backend/internal/pkg/gatewaytiming/history.go
@@ -0,0 +1,245 @@
+package gatewaytiming
+
+import (
+	"container/list"
+	"crypto/sha256"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Recent is diagnostic-only, bounded, process-local and never used for billing,
+// admission, routing, retries or health scores. No request/Gin/context is retained.
+var Recent = NewHistory(4096, 24*time.Hour)
+
+type Scope struct{ UserID, APIKeyID int64 }
+
+type Record struct {
+	SchemaVersion    int              `json:"schema_version"`
+	Source           string           `json:"source"`
+	ObservedAt       time.Time        `json:"observed_at"`
+	RetentionSeconds int64            `json:"retention_seconds"`
+	Capacity         int              `json:"capacity"`
+	Metrics          map[string]int64 `json:"metrics"`
+	BodyReadResult   string           `json:"body_read_result,omitempty"`
+}
+
+type historyKey struct {
+	Scope
+	ID [sha256.Size]byte
+}
+type historyEntry struct {
+	keys   []historyKey
+	record Record
+}
+type historyIndex struct {
+	entry     *list.Element
+	ambiguous bool
+}
+
+// A retired alias must remain ambiguous for the whole overlap of two +/-5m
+// matching windows. Tombstones are bounded too: on exhaustion attribution stops
+// until the overlap has elapsed rather than forgetting an alias and guessing.
+const historyMatchWindow = 5 * time.Minute
+
+type retiredAlias struct {
+	key   historyKey
+	until time.Time
+}
+type History struct {
+	mu           sync.Mutex
+	capacity     int
+	ttl          time.Duration
+	entries      *list.List
+	index        map[historyKey]historyIndex
+	retired      *list.List
+	retiredIndex map[historyKey]*list.Element
+	blockedUntil time.Time
+	now          func() time.Time
+}
+
+func NewHistory(capacity int, ttl time.Duration) *History {
+	if capacity < 1 || capacity > 4096 {
+		capacity = 4096
+	}
+	if ttl <= 0 || ttl > 24*time.Hour {
+		ttl = 24 * time.Hour
+	}
+	return &History{capacity: capacity, ttl: ttl, entries: list.New(), index: make(map[historyKey]historyIndex),
+		retired: list.New(), retiredIndex: make(map[historyKey]*list.Element), now: time.Now}
+}
+
+func boundedHistoryKey(scope Scope, id string) (historyKey, bool) {
+	if len(id) > 160 || strings.ContainsAny(id, "\r\n\x00") {
+		return historyKey{}, false
+	}
+	id = strings.TrimSpace(id)
+	if id == "" {
+		return historyKey{}, false
+	}
+	return historyKey{Scope: scope, ID: sha256.Sum256([]byte(id))}, true
+}
+
+func (h *History) pruneRetired(now time.Time) {
+	for front := h.retired.Front(); front != nil; front = h.retired.Front() {
+		item := front.Value.(retiredAlias)
+		if !now.After(item.until) {
+			break
+		}
+		delete(h.retiredIndex, item.key)
+		h.retired.Remove(front)
+	}
+}
+
+var historyMetricAllowlist = map[string]bool{
+	"body_read_block_ms": true, "body_wire_bytes": true, "body_normalize_ms": true,
+	"body_first_read_ingress_ms": true, "body_last_read_ingress_ms": true,
+	"handler_enter_ingress_ms": true, "body_ready_ingress_ms": true,
+	"security_complete_ingress_ms": true, "routing_start_ingress_ms": true,
+	"user_wait_ms": true, "account_wait_ms": true,
+	"upstream_headers_ms": true, "connection_wait_ms": true,
+	"chat_first_event_ingress_ms": true, "chat_first_text_event_ingress_ms": true,
+	"upstream_semantic_ingress_ms": true, "downstream_semantic_flush_ingress_ms": true,
+	"downstream_write_block_ms": true, "downstream_flush_block_ms": true,
+	"upstream_attempts":         true,
+	"upstream_request_write_ms": true, "upstream_first_byte_ms": true,
+	"upstream_first_event_ingress_ms": true,
+}
+
+func (h *History) Publish(scope Scope, ids []string, snapshot map[string]any) {
+	if h == nil || scope.UserID <= 0 || scope.APIKeyID <= 0 {
+		return
+	}
+	metrics := make(map[string]int64)
+	for name, value := range snapshot {
+		if n, ok := value.(int64); ok && historyMetricAllowlist[name] && n >= 0 && n <= 1<<40 {
+			metrics[name] = n
+		}
+	}
+	if len(metrics) == 0 {
+		return
+	}
+	keys := make([]historyKey, 0, 2)
+	for _, id := range ids {
+		key, valid := boundedHistoryKey(scope, id)
+		if !valid {
+			continue
+		}
+		if len(keys) > 0 && keys[0] == key {
+			continue
+		}
+		keys = append(keys, key)
+		if len(keys) == 2 {
+			break
+		}
+	}
+	if len(keys) == 0 {
+		return
+	}
+	bodyResult, _ := snapshot["body_read_result"].(string)
+	if bodyResult != "complete" && bodyResult != "error" {
+		bodyResult = ""
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	now := h.now()
+	if !h.blockedUntil.IsZero() && !now.After(h.blockedUntil) {
+		return
+	}
+	h.pruneRetired(now)
+	collisions := make(map[historyKey]bool, len(keys))
+	for _, key := range keys {
+		_, collisions[key] = h.retiredIndex[key]
+		if previous, exists := h.index[key]; exists {
+			collisions[key] = collisions[key] || now.Sub(previous.entry.Value.(*historyEntry).record.ObservedAt) < h.ttl
+		}
+	}
+	for front := h.entries.Front(); front != nil; front = h.entries.Front() {
+		entry := front.Value.(*historyEntry)
+		if h.entries.Len() < h.capacity && now.Sub(entry.record.ObservedAt) < h.ttl {
+			break
+		}
+		if !h.remove(front, now) {
+			return
+		}
+	}
+	for _, key := range keys {
+		_, retired := h.retiredIndex[key]
+		collisions[key] = collisions[key] || retired
+	}
+	entry := h.entries.PushBack(&historyEntry{keys: keys, record: Record{
+		SchemaVersion: 1, Source: "process_memory", ObservedAt: now,
+		RetentionSeconds: int64(h.ttl.Seconds()), Capacity: h.capacity,
+		Metrics: metrics, BodyReadResult: bodyResult,
+	}})
+	for _, key := range keys {
+		h.index[key] = historyIndex{entry: entry, ambiguous: collisions[key]}
+	}
+}
+
+func (h *History) Lookup(scope Scope, id string, createdAt time.Time) *Record {
+	if h == nil || scope.UserID <= 0 || scope.APIKeyID <= 0 || createdAt.IsZero() {
+		return nil
+	}
+	key, valid := boundedHistoryKey(scope, id)
+	if !valid {
+		return nil
+	}
+	h.mu.Lock()
+	indexed, found := h.index[key]
+	if !found || indexed.ambiguous {
+		h.mu.Unlock()
+		return nil
+	}
+	entry := indexed.entry.Value.(*historyEntry)
+	if h.now().Sub(entry.record.ObservedAt) >= h.ttl {
+		h.remove(indexed.entry, h.now())
+		h.mu.Unlock()
+		return nil
+	}
+	// Reused identifiers or a delayed, unrelated row must not receive this sample.
+	delta := createdAt.Sub(entry.record.ObservedAt)
+	if delta < -historyMatchWindow || delta > historyMatchWindow {
+		h.mu.Unlock()
+		return nil
+	}
+	result := entry.record
+	h.mu.Unlock()
+	// Cached records are immutable after publication. Copying this snapshot
+	// outside the lock cannot race with eviction or a caller's returned map.
+	result.Metrics = make(map[string]int64, len(entry.record.Metrics))
+	for name, value := range entry.record.Metrics {
+		result.Metrics[name] = value
+	}
+	return &result
+}
+
+func (h *History) remove(element *list.Element, now time.Time) bool {
+	entry := element.Value.(*historyEntry)
+	until := entry.record.ObservedAt.Add(2 * historyMatchWindow)
+	for _, key := range entry.keys {
+		if !now.After(until) {
+			if retired := h.retiredIndex[key]; retired != nil {
+				if until.After(retired.Value.(retiredAlias).until) {
+					retired.Value = retiredAlias{key, until}
+					h.retired.MoveToBack(retired)
+				}
+			} else {
+				if len(h.retiredIndex) >= 2*h.capacity {
+					h.entries.Init()
+					clear(h.index)
+					h.retired.Init()
+					clear(h.retiredIndex)
+					h.blockedUntil = now.Add(2 * historyMatchWindow)
+					return false
+				}
+				h.retiredIndex[key] = h.retired.PushBack(retiredAlias{key, until})
+			}
+		}
+		if h.index[key].entry == element {
+			delete(h.index, key)
+		}
+	}
+	h.entries.Remove(element)
+	return true
+}
diff --git a/backend/internal/pkg/gatewaytiming/history_eviction_test.go b/backend/internal/pkg/gatewaytiming/history_eviction_test.go
new file mode 100644
index 0000000..5bf6e95
--- /dev/null
+++ b/backend/internal/pkg/gatewaytiming/history_eviction_test.go
@@ -0,0 +1,138 @@
+package gatewaytiming
+
+import (
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// This is an audit probe of the unmodified, published helper. It fails until a
+// backend fix can reliably correlate a persisted row with one request instance.
+func TestHistoryDoesNotAttachNewRequestTimingToEvictedOldRow(t *testing.T) {
+	h := NewHistory(1, time.Hour)
+	now := time.Unix(1800000000, 0)
+	h.now = func() time.Time { return now }
+	scope := Scope{UserID: 101, APIKeyID: 201}
+	oldRowCreatedAt := now
+	h.Publish(scope, []string{"client:reused"}, map[string]any{"body_read_block_ms": int64(10)})
+	now = now.Add(time.Second)
+	h.Publish(scope, []string{"client:intervening"}, map[string]any{"body_read_block_ms": int64(20)})
+	now = now.Add(time.Second)
+	h.Publish(scope, []string{"client:reused"}, map[string]any{"body_read_block_ms": int64(999)})
+	if record := h.Lookup(scope, "client:reused", oldRowCreatedAt); record != nil {
+		t.Fatalf("old persisted row incorrectly receives a newer request sample: body_read_block_ms=%d, observed_at=%s, old_row_created_at=%s",
+			record.Metrics["body_read_block_ms"], record.ObservedAt, oldRowCreatedAt)
+	}
+}
+
+func TestHistoryKeepsPrivacyAndCapacityBounds(t *testing.T) {
+	h := NewHistory(4, time.Hour)
+	now := time.Now()
+	scope := Scope{UserID: 101, APIKeyID: 201}
+	h.Publish(scope, []string{"request"}, map[string]any{"body_read_block_ms": int64(0), "prompt": "synthetic-private"})
+	record := h.Lookup(scope, "request", now)
+	if record == nil || len(record.Metrics) != 1 || record.Metrics["body_read_block_ms"] != 0 {
+		t.Fatal("measured zero or metric allowlist was not preserved")
+	}
+	if h.Lookup(Scope{UserID: 102, APIKeyID: 201}, "request", now) != nil {
+		t.Fatal("cross-user timing leaked")
+	}
+	record.Metrics["body_read_block_ms"] = 9
+	if h.Lookup(scope, "request", now).Metrics["body_read_block_ms"] != 0 {
+		t.Fatal("caller mutated the cached sample")
+	}
+	for i := 0; i < 20; i++ {
+		h.Publish(scope, []string{strconv.Itoa(i)}, map[string]any{"body_read_block_ms": int64(i)})
+	}
+	if h.entries.Len() > 4 || len(h.index) > 8 {
+		t.Fatal("bounded cache exceeded capacity")
+	}
+}
+
+func TestHistoryConcurrentReadAndPublish(t *testing.T) {
+	h := NewHistory(32, time.Hour)
+	var workers sync.WaitGroup
+	for worker := int64(1); worker <= 8; worker++ {
+		workers.Add(1)
+		go func(id int64) {
+			defer workers.Done()
+			scope := Scope{UserID: id, APIKeyID: id + 100}
+			for iteration := 0; iteration < 100; iteration++ {
+				key := strconv.Itoa(iteration)
+				h.Publish(scope, []string{key}, map[string]any{"user_wait_ms": int64(iteration)})
+				h.Lookup(scope, key, time.Now())
+			}
+		}(worker)
+	}
+	workers.Wait()
+	if h.entries.Len() > 32 || len(h.index) > 64 {
+		t.Fatal("concurrent cache exceeded capacity")
+	}
+}
+
+func BenchmarkHistoryPublish(b *testing.B) {
+	h := NewHistory(4096, time.Hour)
+	scope := Scope{UserID: 101, APIKeyID: 201}
+	metrics := map[string]any{"body_read_block_ms": int64(10), "user_wait_ms": int64(0)}
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		h.Publish(scope, []string{strconv.Itoa(i)}, metrics)
+	}
+}
+
+func BenchmarkHistoryLookup(b *testing.B) {
+	h := NewHistory(4096, time.Hour)
+	scope := Scope{UserID: 101, APIKeyID: 201}
+	now := time.Now()
+	h.Publish(scope, []string{"request"}, map[string]any{"body_read_block_ms": int64(10), "user_wait_ms": int64(0)})
+	b.ReportAllocs()
+	b.ResetTimer()
+	b.RunParallel(func(pb *testing.PB) {
+		for pb.Next() {
+			h.Lookup(scope, "request", now)
+		}
+	})
+}
+
+func BenchmarkHistoryParallelPublishLookup(b *testing.B) {
+	h := NewHistory(4096, time.Hour)
+	var sequence int64
+	metrics := map[string]any{"body_read_block_ms": int64(10), "user_wait_ms": int64(0)}
+	b.ReportAllocs()
+	b.ResetTimer()
+	b.RunParallel(func(pb *testing.PB) {
+		id := atomic.AddInt64(&sequence, 1)
+		scope := Scope{UserID: id, APIKeyID: id + 100}
+		i := 0
+		for pb.Next() {
+			key := strconv.Itoa(i)
+			h.Publish(scope, []string{key}, metrics)
+			h.Lookup(scope, key, time.Now())
+			i++
+		}
+	})
+}
+
+// Publish rejects aliases over 160 bytes; Lookup should have a comparable bound.
+// Backend reachability of an oversized persisted identifier is not established.
+func BenchmarkHistoryLookupIDLength(b *testing.B) {
+	for _, size := range []int{160, 1024 * 1024} {
+		b.Run(strconv.Itoa(size), func(b *testing.B) {
+			h := NewHistory(4096, time.Hour)
+			scope := Scope{UserID: 101, APIKeyID: 201}
+			id := strings.Repeat("x", size)
+			now := time.Now()
+			b.ReportAllocs()
+			b.ResetTimer()
+			b.RunParallel(func(pb *testing.PB) {
+				for pb.Next() {
+					h.Lookup(scope, id, now)
+				}
+			})
+		})
+	}
+}
