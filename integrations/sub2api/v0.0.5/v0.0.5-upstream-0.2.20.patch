+			}
+			for i := 0; i < 100; i++ {
+				reader.jobs = append(reader.jobs, retryHistoryJob(fmt.Sprintf("unrelated-%d", i), "", BatchImageJobStatusCompleted, 1))
+			}
+			reader.beforeRead = func(kind, _ string, offset int) error {
+				if kind == failureKind && offset == 100 {
