+
+type sessionReviewBlockedUsers struct {
+	service.UserRepository
+	user    service.User
+	entered chan struct{}
+	release chan struct{}
+}
+
+func (r *sessionReviewBlockedUsers) GetByID(context.Context, int64) (*service.User, error) {
+	close(r.entered)
+	<-r.release
+	clone := r.user
+	return &clone, nil
+}
