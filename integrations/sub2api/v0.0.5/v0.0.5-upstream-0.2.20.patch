+func replaySavedSubmission(t *testing.T) (*BatchImagePublicService, *submissionReplayReadRepository, *BatchImageJob, BatchImageSubmitRequest) {
+	t.Helper()
+	svc, repo, _, _, _ := newTestBatchImagePublicService(true)
