+func (r *submissionReplayReadRepository) GetBatchImageJobByIdempotencyKey(ctx context.Context, userID, apiKeyID int64, key string) (*BatchImageJob, error) {
+	r.calls.Add(1)
+	return r.lookup(ctx, userID, apiKeyID, key)
+}
