From 6ece84f3b8a2cd6024078c97120e5bcd103c924d Mon Sep 17 00:00:00 2001
From: daniei-chen <daniei-chen@users.noreply.github.com>
Date: Sun, 15 Nov 2026 02:48:19 +0800
Subject: [PATCH] ci: run the race detector as its own job

Wires the new make test-race target into CI so a data race in the slot/cache/
limiter paths fails the build instead of waiting for production.
---
 .github/workflows/backend-ci.yml | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/.github/workflows/backend-ci.yml b/.github/workflows/backend-ci.yml
index 892817ed6..23d17505c 100644
--- a/.github/workflows/backend-ci.yml
+++ b/.github/workflows/backend-ci.yml
@@ -43,6 +43,26 @@ jobs:
         working-directory: backend
         run: make test-integration
 
+  race:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-go@v6
+        with:
+          go-version-file: backend/go.mod
+          check-latest: false
+          cache: true
+          cache-dependency-path: backend/go.sum
+      - name: Verify Go version
+        run: |
+          go version | grep -q 'go1.27.4'
+      # 并发是这个网关最危险的失效面（槽位泄漏、缓存竞态、限流计数）。
+      # go vet / golangci-lint 都看不出数据竞争，只有 -race 能。
+      # 全量 -race 要跑十几分钟，所以只挑并发相关的测试；约 95 秒。
+      - name: Race detector on concurrency-critical tests
+        working-directory: backend
+        run: make test-race
+
   frontend:
     runs-on: ubuntu-latest
     steps:
-- 
