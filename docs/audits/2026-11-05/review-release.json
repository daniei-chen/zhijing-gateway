      "id": "QA-01",
      "severity": "P3 (loopback synthetic service only)",
      "status": "fixed",
      "title": "Malformed preview HTTP requests could read unbounded bodies or crash handler threads",
      "evidence": "Negative Content-Length reached read(-1); nonnumeric/duplicate framing, non-object JSON, oversize bodies and invalid pagination were not rejected at the boundary.",
      "fix": "Unsigned bounded Content-Length, reject ambiguous framing, 16KiB cap, read timeout, object JSON validation and client errors for invalid query inputs; synthetic login remains supported.",
      "paths": [
        "qa/preview_server.py"
      ],
      "validation": [
