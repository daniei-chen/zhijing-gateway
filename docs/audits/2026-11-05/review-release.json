        "fixed_python_regressions"
      ]
    },
    {
      "id": "DUP-01",
      "severity": "P2 retry reliability; no server authorization claim",
      "status": "fixed",
      "title": "Account duplicate retry keys were shared across administrators",
      "evidence": "Account operation cache/sessionStorage used account ID alone, unlike groups and monitors. A second administrator reused the first administrator's failed-operation key.",
      "fix": "Use admin ID plus account ID for caches and key prefix; no persistence for an unparseable identity; do not adopt legacy ownerless keys.",
      "paths": [
        "frontend/src/api/admin/accounts.ts"
      ],
      "validation": [
        "baseline_duplicate_operations",
        "fixed_duplicate_operations",
        "fixed_targeted_lint"
      ],
      "limitation": "Server idempotency scope is unavailable. Old ownerless ambiguous operations cannot safely be assigned to a user during upgrade; check server state before reissuing a formerly ambiguous operation."
    },
    {
      "id": "DUP-02",
      "severity": "P2 retry reliability",
      "status": "fixed",
      "title": "Late duplicate success erased a newer operation retry key",
      "evidence": "Two calls share key A; the first completes, a new operation starts with B, then the older late success unconditionally deletes B. A failed B retry receives a new key and may repeat the operation.",
      "fix": "Memory and sessionStorage delete independently only if each still contains this request's captured key; preserve keys on ambiguous failure.",
      "paths": [
        "frontend/src/api/admin/accounts.ts",
        "frontend/src/api/admin/groups.ts",
        "frontend/src/api/admin/channelMonitor.ts"
      ],
      "validation": [
