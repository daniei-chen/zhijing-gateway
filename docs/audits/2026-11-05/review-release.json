    {
      "id": "BACK-01",
      "severity": "P2 diagnostic attribution only",
      "status": "open; static proof, Go execution unavailable",
      "title": "Reused request ID after intervening eviction can attach a new sample to an old persisted row",
      "evidence": "History capacity=1: Publish reused(10), Publish other(20) evicts reused and its index, Publish reused(999) sees no collision. Lookup(reused, oldCreatedAt) within +/-5min returns 999. Isolation by user/API key remains; this is not a billing or cross-tenant claim.",
      "paths": [
        "integrations/sub2api/v0.0.2-diagnostics.patch"
      ],
      "patch_lines": "230-409 (history.go new-file hunk)",
      "repro": "python3 tools/audit_backend_history.py --go /path/to/go --mode test --race",
      "expected": "The no-misattribution probe should fail against the unchanged released helper. It has not been compiled or run here.",
      "next_step": "Use a persisted per-request-instance correlation identifier or a bounded fail-closed ambiguity strategy with a clear eviction policy, then verify against the matching complete backend. Do not silently replace historical release patch/manifests."
    },
    {
      "id": "BACK-PERF-01",
      "severity": "P3 unmeasured engineering concern",
      "status": "open; benchmark authored, not executed",
      "title": "History Lookup serializes hash/copy work under a global mutex",
      "evidence": "Lookup hashes an unbounded identifier while holding h.mu and copies all metrics before unlocking. Publish validates ID length but Lookup does not. Complete backend reachability of oversized persisted identifiers is not established.",
      "paths": [
        "integrations/sub2api/v0.0.2-diagnostics.patch"
      ],
      "repro": "python3 tools/audit_backend_history.py --go /path/to/go --mode benchmark",
      "next_step": "Validate/normalize/hash before locking and copy immutable result outside the lock after Go race/bench validation; do not claim measured gateway latency or TPS from this source inspection."
    },
    {
      "id": "CROSS-01",
      "severity": "P2 candidate lifecycle issue",
      "status": "fixed by root following independent review",
      "title": "Account test terminal event needed to stop without waiting for EOF",
      "evidence": "Initial candidate only marked terminal and could hold reader/pending work if upstream remained open.",
      "fix": "Root now returns at terminal, ignores later same-chunk records, releases/cancels in finally, and incrementally scans unfinished records. Independent final review found no new slicing/terminal defect."
    },
    {
      "id": "CROSS-02",
      "severity": "P2 candidate session-bound export issue",
      "status": "fixed by root following independent review",
      "title": "Export needed a final session check after potentially long XLSX serialization",
      "evidence": "Checking active before synchronous XLSX.write leaves a cross-tab session-change window before saveAs.",
